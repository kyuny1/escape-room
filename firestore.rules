rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomOpen(code) {
      return exists(/databases/$(database)/documents/rooms/$(code))
        && get(/databases/$(database)/documents/rooms/$(code)).data.open == true;
    }

    // index is zero-based. The current 30 questions repeat answers [1, 2, 0, 3].
    // Update this function whenever the question order or answer key changes.
    function correctAnswer(index) {
      return index % 4 == 0 ? 1
        : index % 4 == 1 ? 2
        : index % 4 == 2 ? 0
        : 3;
    }

    match /rooms/{code} {
      // Signed-in users can check whether a room code exists/is open.
      allow get: if signedIn();
      allow list, create, update, delete: if false;

      match /players/{uid} {
        // Only authenticated participants can see the live leaderboard for an open room.
        allow get, list: if signedIn() && roomOpen(code);

        allow create: if signedIn()
          && roomOpen(code)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12
          && request.resource.data.index == 0
          && request.resource.data.score == 0
          && request.resource.data.lastAnswer == -1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn()
          && roomOpen(code)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'index', 'score', 'lastAnswer', 'updatedAt'
          ])
          && request.resource.data.nickname == resource.data.nickname
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.index == resource.data.index + 1
          && request.resource.data.index <= 30
          && request.resource.data.score
            == resource.data.score
              + (request.resource.data.lastAnswer == correctAnswer(resource.data.index) ? 10 : 0)
          && request.resource.data.score % 10 == 0
          && request.resource.data.lastAnswer in [0, 1, 2, 3]
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }
    }
  }
}