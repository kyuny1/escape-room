rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomOpen(code) {
      return exists(/databases/$(database)/documents/rooms/$(code))
        && get(/databases/$(database)/documents/rooms/$(code)).data.open == true;
    }

    match /rooms/{code} {
      // 참여 코드를 확인하는 데 필요한 문서 읽기만 허용합니다.
      allow get: if signedIn();
      allow list, create, update, delete: if false;

      match /players/{uid} {
        // 순위표는 열린 방의 참가자에게만 공개됩니다.
        allow get, list: if signedIn() && roomOpen(code);

        allow create: if signedIn()
          && roomOpen(code)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12
          && request.resource.data.index == 0
          && request.resource.data.score == 0
          && request.resource.data.lastAnswer == -1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn()
          && roomOpen(code)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'nickname', 'index', 'score', 'lastAnswer', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'index', 'score', 'lastAnswer', 'updatedAt'
          ])
          && request.resource.data.nickname == resource.data.nickname
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.index == resource.data.index + 1
          && request.resource.data.index <= 30
          && request.resource.data.score >= resource.data.score
          && request.resource.data.score <= resource.data.score + 10
          && request.resource.data.score % 10 == 0
          && request.resource.data.lastAnswer in [0, 1, 2, 3]
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }
    }
  }
}